<odoo>
  <template id="plantilla_reporte_reserva">
    <t t-call="web.external_layout">
      <t t-foreach="docs" t-as="o">
        <div class="page">
          <h2>Confirmación de reserva</h2>

          <p><strong>Referencia:</strong> <span t-esc="o.referencia"/></p>
          <p><strong>Cliente:</strong> <span t-esc="o.cliente_id.name"/></p>
          <p><strong>Pista:</strong> <span t-esc="o.pista_id.nombre"/> (<span t-esc="o.pista_id.tipo_pista"/>)</p>

          <p><strong>Inicio:</strong> <span t-esc="o.inicio"/></p>
          <p><strong>Fin:</strong> <span t-esc="o.fin"/></p>

          <p><strong>Duración:</strong> <span t-esc="o.duracion_horas"/> h</p>
          <p><strong>Total:</strong> <span t-esc="o.total"/> €</p>

          <hr/>
          <p><em>Gracias por reservar en el club. Si hay cambios, contacta con recepción.</em></p>
        </div>
      </t>
    </t>
  </template>
</odoo>
