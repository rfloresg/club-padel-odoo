
<odoo>
  <data>
    <record id="vista_producto_form_inherit_padel" model="ir.ui.view">
      <field name="name">product.template.form.inherit.club_padel</field>
      <field name="model">product.template</field>
      <field name="inherit_id" ref="product.product_template_only_form_view"/>
      <field name="arch" type="xml">
        <xpath expr="//sheet/notebook" position="inside">
          <page string="Pádel">
            <group>
              <field name="es_producto_padel"/>
              <field name="tipo_producto_padel" attrs="{'invisible':[('es_producto_padel','=',False)]}"/>
            </group>
          </page>
        </xpath>
      </field>
    </record>
  </data>
</odoo>

